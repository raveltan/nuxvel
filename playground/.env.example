# Database
# Postgres connection the app uses at runtime.
NUXT_DATABASE_URL=postgres://nuxvel:nuxvel@localhost:5432/nuxvel
# Postgres connection that owns the tables. Migrations and the test setup use it.
NUXT_DATABASE_OWNER_URL=postgres://nuxvel:nuxvel@localhost:5432/nuxvel

# Auth
# Secret that signs sessions. create-nuxvel writes a random one into .env.
NUXT_AUTH_SECRET=changeme
# Optional: OAuth app of each provider in nuxvel.auth.social. The provider calls back to /api/auth/callback/<provider>.
# NUXT_AUTH_GITHUB_CLIENT_ID=
# NUXT_AUTH_GITHUB_CLIENT_SECRET=

# Redis
# Redis connection for the queue, rate limits and useRedis().
NUXT_REDIS_URL=redis://localhost:6379
# Optional: a separate Redis for cached values, flag targeting and rate limits. Empty uses NUXT_REDIS_URL.
# NUXT_REDIS_CACHE_URL=

# Mail
# SMTP server that sends mail. In development, Mailpit shows it at http://localhost:8025.
NUXT_MAIL_URL=smtp://localhost:1025
# Optional: the Mailpit address that the DevTools mail panel reads. The default is http://localhost:8025.
# NUXT_MAILPIT_URL=
# Optional: the From address of every mail. It overrides nuxvel.mail.from.
# NUXT_NUXVEL_MAIL_FROM=

# Storage
# S3-compatible storage. The user and password are the access key and secret.
NUXT_STORAGE_URL=http://nuxvel:nuxvel-secret@localhost:8333
# Bucket that uploads go to. Run nuxvel storage:setup to create it.
NUXT_STORAGE_BUCKET=nuxvel

# Web push
# Optional: public VAPID key for web push notifications. Run nuxvel push:keys to write the key pair.
NUXT_PUBLIC_PUSH_VAPID_PUBLIC_KEY=
# Optional: private VAPID key that signs web push notifications. nuxvel push:keys writes it.
NUXT_PUSH_VAPID_PRIVATE_KEY=
# Optional: a mailto: or https: URL where the push services can contact you.
NUXT_PUSH_VAPID_SUBJECT=

# Billing
# Optional, with nuxvel.billing on: a Stripe secret or restricted key. Required in production. Outside production use a test key (sk_test_): the server refuses a live key there.
# NUXT_STRIPE_SECRET_KEY=
# Optional, with nuxvel.billing on: the signing secret (whsec_) of the Stripe webhook endpoint for /api/webhooks/stripe. Required in production. stripe listen prints one in development.
# NUXT_STRIPE_WEBHOOK_SECRET=

# Monitoring
# Optional: DSN of a Sentry-compatible error tracker. Empty turns error tracking off.
NUXT_PUBLIC_SENTRY_DSN=
# Optional: silent, fatal, error, warn, info, debug or trace. The default is info.
# NUXT_LOG_LEVEL=
# Optional: pretty or json. The default is pretty in nuxt dev and json in all other cases.
# NUXT_LOG_FORMAT=

# Production
# Required in production: the public origin of the app, e.g. https://app.example.com. The auth mail links, canonical links and the sitemap start with it. It overrides nuxvel.seo.siteUrl.
# NUXT_SITE_URL=
# Required in production: a random value of at least 32 characters (openssl rand -hex 32) that keys the audit log hash chain. Never change it: rows written under another value fail nuxvel audit:verify. Empty outside production uses NUXT_AUTH_SECRET.
# NUXT_AUDIT_CHAIN_SECRET=
# Required in production with seo.ogImage, which the starter turns on: a random value (npx nuxt-og-image generate-secret) that signs the Open Graph image URLs. Use the same value in the build and on every server. Another value makes the cached pages point at image URLs that the server refuses.
# NUXT_OG_IMAGE_SECRET=
# Optional: true, or the number of proxies in front of the app. It overrides nuxvel.security.trustProxy.
# NUXT_NUXVEL_SECURITY_TRUST_PROXY=
# Optional: worker runs the queue worker in this server. nuxvel dev sets it for you.
# NUXVEL_ROLE=
# Optional: the number of jobs of each queue that the worker runs at the same time. The default is 5.
# NUXVEL_WORKER_CONCURRENCY=
# Optional: comma-separated queues that the worker runs. Empty runs every queue.
# NUXVEL_WORKER_QUEUES=
