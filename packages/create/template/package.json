{
  "name": "nuxvel-app",
  "type": "module",
  "private": true,
  "imports": {
    "#nuxvel/test-namespaces": "./.nuxt/nuxvel/test-namespaces.mjs",
    "#nuxvel/schema": "./.nuxt/nuxvel/schema.ts",
    "#nuxvel/factories": "./.nuxt/nuxvel/factories.ts",
    "#server/*": "./server/*",
    "#shared/*": "./shared/*"
  },
  "scripts": {
    "dev": "nuxvel dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "npm run test:functional && npm run test:ui",
    "test:functional": "nuxvel test",
    "pretest:ui": "playwright-core install chromium-headless-shell",
    "test:ui": "nuxvel test:ui",
    "pretest:e2e": "playwright-core install chromium-headless-shell",
    "test:e2e": "nuxvel test:e2e",
    "test:arch": "nuxvel test:arch",
    "typecheck": "nuxt typecheck",
    "storybook": "storybook dev --port 6006",
    "storybook:build": "storybook build"
  },
  "dependencies": {
    "@nuxvel/nuxt": "*",
    "@takumi-rs/core": "^2.14.0",
    "better-auth": "^1.7.5",
    "drizzle-orm": "^0.45.2",
    "nuxt": "^4.5.2",
    "nuxt-og-image": "^6.9.0",
    "postgres": "^3.4.9",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@nuxt/test-utils": "^4.3.2",
    "@nuxvel/cli": "*",
    "@storybook-vue/nuxt": "^10.0.0",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-vitest": "^10.6.1",
    "@types/node": "^22.20.3",
    "@vitest/browser-playwright": "^5.0.1",
    "axe-core": "^4.13.0",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.0",
    "msw": "^2.15.0",
    "msw-storybook-addon": "^3.0.3",
    "playwright": "^1.63.0",
    "playwright-core": "^1.63.0",
    "storybook": "^10.6.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.11"
  },
  "msw": {
    "workerDirectory": [
      ".storybook/public"
    ]
  },
  "allowScripts": {
    "esbuild": true,
    "msgpackr-extract": true,
    "msw": true,
    "vue-demi": true
  }
}
